<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- La suite pasó de los 128M del php.ini de desarrollo (889 tests, pico
             medido ~130M): sin esto `php artisan test` muere con "Allowed memory
             size exhausted" en Filesystem.php ANTES de correr un solo test. Se
             fija aca para que el limite viaje con el repo y no dependa del
             php.ini de cada maquina.
             OJO (gate R-31): en la CI el SAPI cli suele venir con memory_limit=-1
             (ilimitado), asi que esta linea NO "salva" la CI — le pone un techo
             de 512M, holgado frente al pico actual. Si algun dia la suite lo
             roza, el sintoma sera el mismo de hoy: revisar el pico antes de
             subir el numero, para no tapar una fuga real. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="AUDITING_ENABLED" value="true"/>
        <env name="AUDITING_CONSOLE" value="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
